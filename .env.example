# OCR service
OCR_BASE_URL=http://192.168.130.77:8091
OCR_API_KEY=replace_me
OCR_TIMEOUT_SECONDS=7200

# Full-LLM endpoint. Set ONE of these styles.
CHUNKER_LLM_URL=http://YOUR_LLM_HOST:PORT/v1/chat/completions
# CHUNKER_LLM_URLS=http://host:8200/v1/chat/completions,http://host:8300/v1/chat/completions
# CHUNKER_LLM_HOST=192.168.130.220
# CHUNKER_LLM_PORTS=8200,8300,8400,8500

CHUNKER_LLM_MODEL=auto
CHUNKER_LLM_API_KEY=
CHUNKER_LLM_TIMEOUT=240
CHUNKER_LLM_CONCURRENCY=16
CHUNKER_LLM_MAX_OUTPUT_TOKENS=1024

# Current Full-LLM defaults
ATOMIZER_OVERLAP_LINES=8
PLANNER_OVERLAP_UNITS=4

# API/job service
JOB_WORKERS=1
MAX_UPLOAD_MB=500
DATA_ROOT=/data/jobs
CORS_ORIGINS=*
